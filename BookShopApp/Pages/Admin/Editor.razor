@page "/admin/products/edit/{id:long}"
@page "/admin/products/create"
@inherits OwningComponentBase<IStoreRepository>

<style>div.validation-message { color: rgb(220, 53, 69); font-weight: 500 }</style>

<h3 class="bg-@ThemeColor text-white text-center p-1">@TitleText a Product</h3>
<EditForm Model="Product" OnValidSubmit="SaveProduct">
    <DataAnnotationsValidator />
    @if (Product.ProductId.HasValue && Product.ProductId.Value != 0)
    {
        <div class="form-group">
            <label>ID</label>
            <input class="form-control" disabled value="@Product.ProductId" />
        </div>
    }
    <div class="form-group">
        <label>Name</label>
        <ValidationMessage For="@(() => Product.Name)" />
        <InputText class="form-control" @bind-Value="Product.Name" />
    </div>
    <div class="form-group">
        <label>Author</label>
        <ValidationMessage For="@(() => Product.Author)" />
        <InputText class="form-control" @bind-Value="Product.Author" />
    </div>
    <div class="form-group">
        <label>Description</label>
        <ValidationMessage For="@(() => Product.Description)" />
        <InputText class="form-control" @bind-Value="Product.Description" />
    </div>
    <div class="form-group">
        <label>Category</label>
        <ValidationMessage For="@(() => Product.Category)" />
        <InputText class="form-control" @bind-Value="Product.Category" />
    </div>
    <div class="form-group">
        <label>Price</label>
        <ValidationMessage For="@(() => Product.Price)" />
        <InputNumber class="form-control" @bind-Value="Product.Price" />
    </div>
    <div class="form-group">
        <label>Current Image</label>
        <img src="@Product.ImageUrl" alt="@Product.Name" style="width:150px" />
    </div>
    <div class="form-group">
        <label>Upload New Image</label>
        <InputFile OnChange="UploadImage" />
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-@ThemeColor">Save</button>
        <NavLink class="btn btn-secondary" href="/admin/products">Cancel</NavLink>
    </div>
</EditForm>
@code {
    public IStoreRepository Repository => Service;

    [Inject]
    public NavigationManager? NavManager { get; set; }

    [Parameter]
    public long Id { get; set; }

    public Product Product { get; set; } = new Product();
    public string? SelectedFileName { get; set; }
    public string? NewImageUrl { get; set; }

    protected override void OnParametersSet()
    {
        if (Id != 0)
        {
            Product = Repository.Products.FirstOrDefault(p => p.ProductId == Id) ?? new();
        }
    }

    public void SaveProduct()
    {
        if (!string.IsNullOrEmpty(NewImageUrl))
        {
            Product.ImageUrl = NewImageUrl;
        }

        if (Id == 0)
        {
            Repository.CreateProduct(Product);
        }
        else
        {
            Repository.SaveProduct(Product);
        }
        NavManager?.NavigateTo("/admin/products");
    }

    public async Task UploadImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            SelectedFileName = file.Name;
            var path = Path.Combine("wwwroot", "img", file.Name);
            await using var stream = file.OpenReadStream();
            await using var fileStream = new FileStream(path, FileMode.Create);
            await stream.CopyToAsync(fileStream);
            NewImageUrl = $"/img/{file.Name}";
        }
        
    }

    public string ThemeColor => Id == 0 ? "primary" : "warning";
    public string TitleText => Id == 0 ? "Create" : "Edit";
}
